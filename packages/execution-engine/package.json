{
  "name": "@hi-mcp/execution-engine",
  "version": "0.1.0",
  "description": "Deterministic, policy-enforced HTTP execution for compiled HiMCP capabilities.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@hi-mcp/capability-ir": "workspace:*",
    "ajv": "^8.17.1",
    "safe-regex2": "^5.1.1",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}

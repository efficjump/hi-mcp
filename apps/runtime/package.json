{
  "name": "@hi-mcp/runtime",
  "version": "0.1.0",
  "description": "Run verified HiMCP releases as local MCP servers.",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "himcp-runtime": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --sourcemap --clean --target node22 && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@hi-mcp/capability-ir": "workspace:*",
    "@hi-mcp/deterministic-verifier": "workspace:*",
    "@hi-mcp/execution-engine": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}

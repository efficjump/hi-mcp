{
  "name": "@hi-mcp/web",
  "version": "0.1.0",
  "private": true,
  "description": "Local web console for compiling API contracts into verified MCP connections.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsup src/server/index.ts --format esm --sourcemap --clean --target node22 --out-dir dist/server --external vite && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "HIMCP_WEB_DEV=1 tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@hi-mcp/capability-ir": "workspace:*",
    "@hi-mcp/cli": "workspace:*",
    "@hi-mcp/deterministic-verifier": "workspace:*",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
